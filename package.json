{
  "name": "@cbbs/react-native-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:react-native": "python3 scripts/scaffold_audit_react_native.py",
    "doctor:expo": "pnpm --filter @cbbs/client exec expo-doctor",
    "lint": "eslint apps/cbbs-client/app apps/cbbs-client-windows/src apps/cbbs-client-windows/__tests__ apps/cbbs-hardware-tools-windows/src apps/cbbs-hardware-tools-windows/__tests__ apps/cbbs-sysop-windows/src apps/cbbs-sysop-windows/__tests__ apps/cbbs-windows/src apps/cbbs-windows/__tests__ packages --ext .ts,.tsx --max-warnings=0",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false"
  },
  "devDependencies": {
    "@babel/core": "*",
    "@testing-library/react-native": "*",
    "@types/jest": "^29.5.14",
    "@types/react": "*",
    "@typescript-eslint/eslint-plugin": "*",
    "@typescript-eslint/parser": "*",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "*",
    "eslint": "^9.39.1",
    "eslint-config-expo": "*",
    "expo-doctor": "*",
    "jest": "^29.7.0",
    "jest-expo": "*",
    "react-test-renderer": "19.2.3",
    "typescript": "*"
  }
}
